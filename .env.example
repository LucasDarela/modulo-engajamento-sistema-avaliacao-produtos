# Supabase: Project Settings > API (local: `supabase status -o env`, API_URL e SERVICE_ROLE_KEY)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo para assinar o JWT da sessão (openssl rand -base64 32)
SESSION_SECRET=

# Chave exigida no header x-api-key do POST /api/v1/products (só o n8n conhece)
# Gere com: openssl rand -hex 32
ADMIN_API_KEY=

# Resumo de avaliações por IA (Mastra + gpt-4o-mini)
OPENAI_API_KEY=
